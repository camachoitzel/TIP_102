class Student:
    def __init__(self, name, age, major):
        self.name = name
        self.age = age
        self.major = major

    def introduction(self):
        return f"Hi, I am {self.name}, a {self.age} years old {self.major} major"

    def hi(self):
        return f"Hi, my name is {self.name}"

s1 = Student("Alice" , 20, "CS")
s2 = Student("Bob" , 22, "Math")

